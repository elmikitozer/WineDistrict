// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Use a direct (non-pooled) connection for migrations/introspection
  // This avoids issues with PgBouncer transaction pooling on port 6543
  directUrl = env("DIRECT_URL")
}

model Caviste {
  id          Int           @id @default(autoincrement())
  nom         String
  adresse     String
  stocks      Stock[]
  reservation Reservation[]

  @@unique([nom], name: "caviste_nom_unique") 
}

model Vin {
  id          Int           @id @default(autoincrement())
  nom         String        
  domaine     String
  année       Int
  prix        Float
  couleur     String        //"rouge" | "blanc" | "rose"
  imageFile   String?
  stocks      Stock[]
  reservation Reservation[]


  @@unique([nom, domaine, année], name: "vin_unique")
}

model Stock {
  id        Int     @id @default(autoincrement())
  vinId     Int
  cavisteId Int
  quantite  Int

  vin       Vin     @relation(fields: [vinId], references: [id], onDelete: Cascade)
  caviste   Caviste @relation(fields: [cavisteId], references: [id], onDelete: Cascade)

  @@unique([cavisteId, vinId], name: "stock_unique_caviste_vin")
}

model Reservation {
  id        String  @id @default(cuid())
  vinId     Int
  cavisteId Int
  date      DateTime @default(now())
  status    String   @default("en_attente")

  vin       Vin     @relation(fields: [vinId], references: [id], onDelete: Cascade)
  caviste   Caviste @relation(fields: [cavisteId], references: [id], onDelete: Cascade)
}
