// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Use a direct (non-pooled) connection for migrations/introspection
  // This avoids issues with PgBouncer transaction pooling on port 6543
  directUrl = env("DIRECT_URL")
}

model Caviste {
  id          Int           @id @default(autoincrement())
  nom         String
  adresse     String
  stocks      Stock[]
  reservation Reservation[]
  users       User[]
  integrations IntegrationConnection[]
  externalProductMappings ExternalProductMapping[]

  @@unique([nom], name: "caviste_nom_unique")
}

model Vin {
  id          Int           @id @default(autoincrement())
  nom         String
  domaine     String
  année       Int
  prix        Float
  couleur     String        //"rouge" | "blanc" | "rose"
  imageFile   String?
  stocks      Stock[]
  reservation Reservation[]
  externalProductMappings ExternalProductMapping[]


  @@unique([nom, domaine, année], name: "vin_unique")
}

model Stock {
  id        Int     @id @default(autoincrement())
  vinId     Int
  cavisteId Int
  quantite  Int

  vin       Vin     @relation(fields: [vinId], references: [id], onDelete: Cascade)
  caviste   Caviste @relation(fields: [cavisteId], references: [id], onDelete: Cascade)

  @@unique([cavisteId, vinId], name: "stock_unique_caviste_vin")
}

model Reservation {
  id        String  @id @default(cuid())
  vinId     Int
  cavisteId Int
  date      DateTime @default(now())
  status    String   @default("en_attente")

  vin       Vin     @relation(fields: [vinId], references: [id], onDelete: Cascade)
  caviste   Caviste @relation(fields: [cavisteId], references: [id], onDelete: Cascade)
}

// Authentication user for dashboard access
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("CAVISTE")
  cavisteId    Int?
  caviste      Caviste?  @relation(fields: [cavisteId], references: [id])
  client       Client?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Client profile for non-caviste users
model Client {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// Optional integration tables for external POS/stock providers (e.g., SumUp)
/// NOTE: Create a migration before using these models in code.
model IntegrationConnection {
  id          String   @id @default(cuid())
  cavisteId   Int
  provider    String   // e.g. "sumup"
  accessToken String
  refreshToken String?
  scope       String?
  merchantId  String?  // external merchant/account identifier
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  caviste     Caviste  @relation(fields: [cavisteId], references: [id], onDelete: Cascade)

  @@unique([provider, cavisteId])
  @@index([provider, cavisteId])
}

model ExternalProductMapping {
  id               String   @id @default(cuid())
  cavisteId        Int
  vinId            Int
  provider         String   // e.g. "sumup"
  externalProductId String  // provider product id
  externalSku      String?
  lastSeenAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  caviste Caviste @relation(fields: [cavisteId], references: [id], onDelete: Cascade)
  vin     Vin     @relation(fields: [vinId], references: [id], onDelete: Cascade)

  @@unique([provider, cavisteId, externalProductId], name: "external_product_unique")
  @@index([cavisteId, vinId])
}
